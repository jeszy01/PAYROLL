APP_NAME="Payroll & Benefits API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=payroll_benefits
DB_USERNAME=payroll_user
DB_PASSWORD=payroll_pass

SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
SESSION_DOMAIN=localhost

# Payslip emailing — defaults to logging mail instead of sending it, so
# this works out of the box. Set MAIL_MAILER=smtp and fill in the rest
# to actually deliver payslip emails.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@payroll-benefits.local
MAIL_FROM_NAME="Payroll & Benefits"

# Payslip SMS — no SMS gateway is wired up yet. Sending "via SMS" from
# this system currently just records that it was requested; to actually
# deliver texts, integrate a provider (e.g. Semaphore, Twilio, Vonage)
# in AttendanceSummaryController-style fashion inside PayslipController@send.
SMS_PROVIDER=
